{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": ["plugin:testing-library/react", "plugin:cypress/recommended"],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "plugins": ["flowtype", "import", "jsx-a11y", "react", "react-hooks", "testing-library", "jest", "unused-imports"],
  "rules": {
    "curly": "warn",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/order": [
      "warn",
      {
        "alphabetize": { "order": "asc", "caseInsensitive": true },
        "groups": ["builtin", "external", "internal", ["sibling", "parent"], "index", "object"],
        "newlines-between": "always"
      }
    ],
    "testing-library/render-result-naming-convention": "off",
    "jest/no-disabled-tests": "error",
    "jest/no-focused-tests": "error",
    "jest/no-identical-title": "error",
    "jest/prefer-to-have-length": "warn",
    "jest/valid-expect": "error",
    "jsx-a11y/anchor-is-valid": "off",
    "no-useless-escape": "off",
    "object-shorthand": "warn",
    "react/jsx-boolean-value": "warn",
    "react/self-closing-comp": "warn",
    "unused-imports/no-unused-imports": "warn",
    "unused-imports/no-unused-vars": [
      // turn this back on
      "off",
      { "vars": "all", "varsIgnorePattern": "^_", "args": "after-used", "argsIgnorePattern": "^_" }
    ]
  },
  "settings": {
    // This list should include all path entries in tsconfig.json
    "import/internal-regex": "^actions|assets|components|containers|contexts|hooks|i18nRes|pages|reducers|selectors|store|styles|tests|utils/"
  }
}
