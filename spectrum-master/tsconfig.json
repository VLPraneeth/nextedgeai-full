{
  "compilerOptions": {
    "sourceMap": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "removeComments": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": "./src",
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "lib": ["dom", "esnext"],
    "paths": {
      "__COMMENT__": ["Any additions here should be added to .eslintrc.json > settings > import/internal-regex"],
      "actions/*": ["./actions/*"],
      "assets/*": ["./assets/*"],
      "components/*": ["./components/*"],
      "containers/*": ["./containers/*"],
      "contexts/*": ["./contexts/*"],
      "hooks/*": ["./hooks/*"],
      "i18nRes/*": ["./i18n/*"],
      "mocks/*": ["./mocks/*"],
      "pages/*": ["./pages/*"],
      "reducers/*": ["./reducers/*"],
      "selectors/*": ["./selectors/*"],
      "store/*": ["./store/*"],
      "styles/*": ["./styles/*"],
      "tests/*": ["./tests/*"],
      "utils/*": ["./utils/*"]
    },
    "types": ["node", "webpack-env"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "./**/*.spec.ts", "./**/*.test.tsx", "./**/*.test.ts"],
  "typeRoots": ["./node_modules/@types", "./types"]
}
