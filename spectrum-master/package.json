  "scripts": {
    "build": "npm run convert-less-to-ts && node scripts/build.js --max-old-space-size=5120",
    "build-debug": "npm run convert-less-to-ts && node --inspect-brk scripts/build.js --max-old-space-size=5120",
    "build-all": "npm run proxy-build && npm run build && npm run prep-deployment && npm run build-container",
    "build-container": "docker build --tag spectrum:latest -f package/Dockerfile .",
    "build-storybook": "storybook build && npm install http-server --prefix=./storybook-static",
    "build-storybook-container": "docker build --tag spectrum-component:latest -f package/play/Dockerfile .",
    "clean": "rimraf build/* proxy/dist; npm run clean-less-constants; mkdirp proxy/dist/public; rimraf storybook-static",
    "clean-build": "npm run clean && npm run clean-node-modules && npm run proxy-install && npm run proxy-build && npm install&& npm run build && npm run prep-deployment",
    "clean-less-constants": "rimraf src/utils/LessConstants.ts",
    "clean-node-modules": "rimraf node_modules proxy/node_modules ",
    "convert-less-to-ts": "./node_modules/.bin/ts-node scripts/lessToTs.ts",
    "cypress:localhost:headless": "cypress run --env username=REPLACE_ME,password=REPLACE_ME --headless --browser chrome",
    "cypress:localhost:open": "cypress open --env username=REPLACE_ME,password=REPLACE_ME --browser chrome",
    "docker-save-image": "docker save spectrum > package/spectrum.tar",
    "eslint": "eslint \"{src,scripts,config,proxy/src}/**/*.{js,jsx,ts,tsx}\"",
    "eslint:fix": "npm run eslint -- --fix",
    "format": "npm run eslint:fix && npm run prettier:write && npm run sort-json",
    "jest": "node ./node_modules/.bin/jest",
    "mock-server": "cd mock-server; node index.js",
    "postinstall": "patch-package",
    "prep-deployment": "mkdirp proxy/dist/public; cp -R build/* proxy/dist/public/ && mv proxy/dist/public/index.html proxy/dist/public/index.template",
    "prettier:write": "prettier --write \"{src,scripts,config,proxy/src}/**/*.{js,jsx,ts,tsx,less,json,md}\"",
    "process-icons": "node scripts/manageicons.js",
    "proxy-build": "cd proxy; npm run build",
    "proxy-install": "cd proxy; npm install; cd -",
    "proxy:dev": "cd proxy; npm run dev",
    "proxy:dev:integration": "cd proxy; ARCADE_TARGET=http://arcade.integration.syncari.net/ npm run dev",
    "remove-svg-title": "node scripts/removeSvgTitle.js",
    "run-container": "docker run -e SPECTRUM_PORT=80 -e ARCADE_TARGET=http://`ipconfig getifaddr en0`:8080/ -e NODE_ENV=production -e ARCADE_LOG_LEVEL=debug -e SECURE_COOKIES=false -e -d -p 80:80 spectrum:latest",
    "snapshot-update": "node scripts/test.js",
    "snapshot-update-ci": "CI=true node scripts/test.js -u",
    "sort-json": "./node_modules/.bin/ts-node scripts/formatJson.ts",
    "start": "npm run convert-less-to-ts && node scripts/start.js",
    "start-simple": "node scripts/start.js",
    "start-mock": "cd mock-server; node ./index.js",
    "storybook": "storybook dev -p 6006",
    "storybook-cached": "storybook dev -p 6006",
    "test": "node scripts/test.js",
    "test-all": "node scripts/test.js --watchAll false --onlyChanged false",
    "test-ci": "npm run convert-less-to-ts && CI=true node scripts/test.js",
    "test-coverage": "node scripts/test.js --coverage",
    "test-coverage-ci": "CI=true node scripts/test.js --silent --coverage",
    "tsc": "node ./node_modules/.bin/tsc",
    "prepare": "husky"
  },
  "moduleDirectories": [
    "src",
    "node_modules"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "Chrome >= 70",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/types.ts"
    ],
    "globals": {
      "ts-jest": {
        "isolatedModules": true
      }
    },
    "setupFiles": [
      "react-app-polyfill/jsdom",
      "jest-canvas-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/__tests__/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "transform": {
      "^.+\\.(js|jsx|cjs|mjs|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|cjs|mjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/proxy/src/"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^utils(.*)$": "<rootDir>/src/utils/$1",
      "^components(.*)$": "<rootDir>/src/components/$1",
      "^pages(.*)$": "<rootDir>/src/pages/$1",
      "^i18nRes(.*)$": "<rootDir>/src/i18n/$1",
      "^containers(.*)$": "<rootDir>/src/containers/$1",
      "^selectors(.*)$": "<rootDir>/src/selectors/$1",
      "^reducers(.*)$": "<rootDir>/src/reducers/$1",
      "^actions(.*)$": "<rootDir>/src/actions/$1",
      "^assets(.*)$": "<rootDir>/src/assets/$1",
      "^styles(.*)$": "<rootDir>/src/styles/$1",
      "^store(.*)$": "<rootDir>/src/store/$1",
      "^mocks(.*)$": "<rootDir>/src/mocks/$1",
      "^tests(.*)$": "<rootDir>/src/tests/$1",
      "^contexts(.*)$": "<rootDir>/src/contexts/$1",
      "^hooks(.*)$": "<rootDir>/src/hooks/$1",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
    "web.js",
    "js",
    "cjs",
    "mjs",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "testTimeout": 40000,
    "globalSetup": "<rootDir>/config/jest/globalSetup.js"
  },
  "babel": {
    "presets": [
      [
        "@babel/env",
        {
          "targets": {
            "node": 6
          }
        }
      ],
      "react-app"
    ],
    "plugins": [
      "lodash",
      "@babel/plugin-proposal-optional-chaining",
      "@babel/plugin-proposal-export-namespace-from",
      [
        "@babel/plugin-transform-react-jsx",
        {
          "runtime": "automatic"
        }
      ],
      [
        "@babel/plugin-transform-private-property-in-object",
        {
          "loose": true
        }
      ],
      [
        "@babel/plugin-transform-private-methods",
        {
          "loose": true
        }
      ]
    ],
    "env": {
      "production": {
        "plugins": [
          [
            "transform-react-remove-prop-types",
            {
              "mode": "remove",
              "removeImport": true,
              "ignoreFilenames": [
                "node_modules"
              ]
            },
            "babel-plugin-jsx-remove-data-test-id"
          ]
        ]
      }
    }
  },
