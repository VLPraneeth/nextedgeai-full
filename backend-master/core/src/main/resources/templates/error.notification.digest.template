<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
        <title>Welcome to NextEdge AI</title>
        <style>
            /* -------------------------------------
        RESPONSIVE AND MOBILE FRIENDLY STYLES
    ------------------------------------- */
            @media only screen and (max-width: 620px) {
                table[class="body"] h1 {
                    font-size: 28px !important;
                    margin-bottom: 10px !important;
                }
                table[class="body"] p,
                table[class="body"] ul,
                table[class="body"] ol,
                table[class="body"] td,
                table[class="body"] span,
                table[class="body"] a {
                    font-size: 16px !important;
                }
                table[class="body"] .wrapper,
                table[class="body"] .article {
                    padding: 10px !important;
                }
                table[class="body"] .content {
                    padding: 0 !important;
                }
                table[class="body"] .container {
                    padding: 0 !important;
                    width: 100% !important;
                }
                table[class="body"] .main {
                    border-left-width: 0 !important;
                    border-radius: 0 !important;
                    border-right-width: 0 !important;
                }
                table[class="body"] .btn table {
                    width: 100% !important;
                }
                table[class="body"] .btn a {
                    width: 100% !important;
                }
                table[class="body"] .img-responsive {
                    height: auto !important;
                    max-width: 100% !important;
                    width: auto !important;
                }
            }

            /* -------------------------------------
        PRESERVE THESE STYLES IN THE HEAD
    ------------------------------------- */
            @media all {
                .ExternalClass {
                    width: 100%;
                }
                .ExternalClass,
                .ExternalClass p,
                .ExternalClass span,
                .ExternalClass font,
                .ExternalClass td,
                .ExternalClass div {
                    line-height: 100%;
                }
                .apple-link a {
                    color: inherit !important;
                    font-family: inherit !important;
                    font-size: inherit !important;
                    font-weight: inherit !important;
                    line-height: inherit !important;
                    text-decoration: none !important;
                }
                #MessageViewBody a {
                    color: inherit;
                    text-decoration: none;
                    font-size: inherit;
                    font-family: inherit;
                    font-weight: inherit;
                    line-height: inherit;
                }
                .btn-primary table td:hover {
                    background-color: #0c6bca !important;
                }
                .btn-primary a:hover {
                    background-color: #0c6bca !important;
                    border-color: #0c6bca !important;
                }
            }
        </style>
    </head>
    <body
        class=""
        style="
            background-color: #f8fafd;
            font-family: sans-serif;
            -webkit-font-smoothing: antialiased;
            font-size: 14px;
            line-height: 1.4;
            margin: 0;
            padding: 0;
            -ms-text-size-adjust: 100%;
            -webkit-text-size-adjust: 100%;
        "
    >
        <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            class="body"
            style="
                border-collapse: separate;
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
                width: 100%;
                background-color: #f8fafd;
            "
        >
            <tr>
                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top">&nbsp;</td>
                <td
                    class="container"
                    style="
                        font-family: sans-serif;
                        font-size: 14px;
                        vertical-align: top;
                        display: block;
                        margin: 0 auto;
                        max-width: 685px;
                        padding: 10px;
                        width: 685px;
                    "
                >
                    <div
                        class="content"
                        style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 685px; padding: 10px"
                    >
                        <!-- START CENTERED WHITE CONTAINER -->
                        <span
                            class="preheader"
                            style="
                                color: transparent;
                                display: none;
                                height: 0;
                                max-height: 0;
                                max-width: 0;
                                opacity: 0;
                                overflow: hidden;
                                mso-hide: all;
                                visibility: hidden;
                                width: 0;
                            "
                        ></span>
                        <table style="width: 100%">
                            <tr style="text-align: center">
                                <td style="background-color: #f8fafd">
                                    <img
                                        style="margin: 25px 0 25px 0"
                                        src="{{ syncariLogoUrl }}"
                                        height="39"
                                        width="190"
                                    />
                                </td>
                            </tr>
                        </table>
                        <table
                            class="main"
                            style="
                                border-collapse: separate;
                                mso-table-lspace: 0pt;
                                mso-table-rspace: 0pt;
                                width: 100%;
                                background: #ffffff;
                                border-radius: 6px;
                            "
                        >
                            <!-- START MAIN CONTENT AREA -->
                            <tr>
                                <td
                                    class="wrapper"
                                    style="
                                        font-family: sans-serif;
                                        font-size: 14px;
                                        vertical-align: top;
                                        box-sizing: border-box;
                                        padding: 40px 80px;
                                        text-align: left;
                                        color: #637079;
                                    "
                                >
                                    <table
                                        border="0"
                                        cellpadding="0"
                                        cellspacing="0"
                                        style="
                                            border-collapse: separate;
                                            mso-table-lspace: 0pt;
                                            mso-table-rspace: 0pt;
                                            width: 100%;
                                        "
                                    >
                                        <tr>
                                            <td style="font-family: sans-serif; font-size: 16px; vertical-align: top">
                                                <p
                                                    style="
                                                        font-family: sans-serif;
                                                        font-size: 16px;
                                                        margin: 0;
                                                        margin-bottom: 15px;
                                                    "
                                                >
                                                    Hi {{ name }},
                                                </p>
                                                <p
                                                    style="
                                                        font-family: sans-serif;
                                                        font-size: 16px;
                                                        font-weight: normal;
                                                        margin: 0;
                                                        margin-bottom: 15px;
                                                    "
                                                >
                                                    Since {{ lastDigestDate|date("MM/dd/yyyy hh:mm a", tz) }}, the following notifications have been
                                                    posted to your account.
                                                </p>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td
                                                align="left"
                                                style="
                                                    font-family: sans-serif;
                                                    font-size: 14px;
                                                    vertical-align: top;
                                                    padding-top: 15px;
                                                "
                                            >
                                                <p
                                                    style="
                                                        font-family: sans-serif;
                                                        font-size: 16px;
                                                        font-weight: normal;
                                                        margin: 0;
                                                        margin-bottom: 15px;
                                                        font-weight: bolder;
                                                    "
                                                >
                                                    {{ notificationsCount }} Notifications
                                                </p>
                                            </td>
                                        </tr>
                                        <table
                                            border="0"
                                            cellpadding="0"
                                            cellspacing="0"
                                            class="btn btn-primary"
                                            style="
                                                border-collapse: separate;
                                                mso-table-lspace: 0pt;
                                                mso-table-rspace: 0pt;
                                                width: 100%;
                                                box-sizing: border-box;
                                            "
                                        >
                                            <tbody>
                                                {% for n in notification %}
											        <tr>
													    <td
													        align="left"
													        style="
													            font-family: sans-serif;
													            font-size: 14px;
													            vertical-align: top;
													            padding-bottom: 15px;
													            border-width: 0;
													            border-top-width: 2px;
													            border-color: #ececec;
													            border-style: solid;
													        "
													    >
													        <p style="font-family: sans-serif; font-size: 16px; font-weight: normal; color: #898989; margin: 6px 0">
													            {{ n.createdAt|date("MM/dd/yyyy hh:mm a", tz) }}
													        </p>
													
													        <p
													            style="
													                font-family: sans-serif;
													                font-size: 16px;
													                font-weight: bolder;
													                text-decoration: none;
													                margin: 0;
													                margin-bottom: 15px;
													                color: #3391ef;
													            "
													        >
													            {{ n.subject }}
													        </p>
													
													        <p style="font-family: sans-serif; font-size: 16px; font-weight: normal; color: #898989; margin: 6px 0">
													            {{ n.body}}
													        </p>
													    </td>
													</tr>
											    {% endfor %}
                                                <tr>
                                                    <td
                                                        style="
                                                            border-color: #ececec;
                                                            border-width: 0;
                                                            border-top-width: 2px;
                                                            border-style: solid;
                                                            margin-bottom: 8px;
                                                            margin-top: 8px;
                                                            padding-bottom: 8px;
                                                        "
                                                    ></td>
                                                </tr>
                                                {% if truncated == true %}
                                                <tr>
                                                    <td style="background-color: #f5f5f5; padding: 0 12px">
                                                        <p>
                                                            There are {{ additionalNotificationsCount }} more
                                                            notifications not displayed in this email. To view them, log
                                                            in to NextEdge AI.
                                                        </p>
                                                        <p>
                                                            <a
                                                                href="{{ allNotificationsUrl }}"
                                                                style="
                                                                    font-family: sans-serif;
                                                                    font-size: 16px;
                                                                    text-decoration: none;
                                                                    margin: 0;
                                                                    margin-bottom: 15px;
                                                                    margin-right: 8px;
                                                                    color: #3391ef;
                                                                "
                                                                >View all notifications</a
                                                            >
                                                            <a
                                                                href="{{ manageNotificationsUrl }}"
                                                                style="
                                                                    font-family: sans-serif;
                                                                    font-size: 16px;
                                                                    text-decoration: none;
                                                                    margin: 0;
                                                                    padding-left: 8px;
                                                                    margin-bottom: 15px;
                                                                    color: #3391ef;
                                                                    border-width: 0;
                                                                    border-left-width: 1px;
                                                                    border-color: #c6c6c6;
                                                                    border-style: solid;
                                                                "
                                                                >Manage notification settings</a
                                                            >
                                                        </p>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </table>
                                </td>
                            </tr>
							{% endif %}
                            <!-- END MAIN CONTENT AREA -->
                        </table>

                        <!-- START FOOTER -->
                        <div class="footer" style="clear: both; margin-top: 10px; text-align: center; width: 100%">
                            <table
                                border="0"
                                cellpadding="0"
                                cellspacing="0"
                                style="
                                    border-collapse: separate;
                                    mso-table-lspace: 0pt;
                                    mso-table-rspace: 0pt;
                                    width: 100%;
                                "
                            >
                                <tr>
                                    <td
                                        class="content-block"
                                        style="
                                            font-family: sans-serif;
                                            vertical-align: top;
                                            padding-bottom: 10px;
                                            padding-top: 10px;
                                            font-size: 12px;
                                            color: #999999;
                                            text-align: center;
                                        "
                                    >
                                        Sent by
                                        <a
                                            href="/"
                                            style="
                                                text-decoration: underline;
                                                color: #999999;
                                                font-size: 12px;
                                                text-align: center;
                                            "
                                            >NextEdge AI</a
                                        >
                                    </td>
                                </tr>
                                <tr>
                                    <td
                                        class="content-block powered-by"
                                        style="
                                            font-family: sans-serif;
                                            vertical-align: top;
                                            padding-bottom: 10px;
                                            padding-top: 10px;
                                            font-size: 12px;
                                            color: #999999;
                                            text-align: center;
                                        "
                                    >
                                        <a href="/" style="color: #999999; font-size: 12px; text-align: center"
                                            >Preferences</a
                                        >
                                        &bull;
                                        <a href="/" style="color: #999999; font-size: 12px; text-align: center"
                                            >Support</a
                                        >
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- END FOOTER -->

                        <!-- END CENTERED WHITE CONTAINER -->
                    </div>
                </td>
                <td style="font-family: sans-serif; font-size: 14px; vertical-align: top">&nbsp;</td>
            </tr>
        </table>
    </body>
</html>
